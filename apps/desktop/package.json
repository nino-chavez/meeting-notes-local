{
  "name": "local-meeting-notes-desktop",
  "private": true,
  "version": "0.5.2",
  "scripts": {
    "test:ui": "node --test ui/*.test.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build && LMN_BUNDLE_APP=\"../../target/release/bundle/macos/Yawn.app\" ../../scripts/prepare-preview-bundle.sh sign",
    "preview": "tauri dev --config src-tauri/tauri.preview.conf.json --features preview-surface",
    "preview-build": "tauri build --config src-tauri/tauri.preview.conf.json --features preview-surface && ../../scripts/prepare-preview-bundle.sh sign",
    "preview-verify": "../../scripts/prepare-preview-bundle.sh verify"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0"
  }
}
