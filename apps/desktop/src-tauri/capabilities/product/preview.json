{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "preview-window",
  "description": "The local Preview build exercises the same single meeting-notes flow as the shipped window, including retained source passages for completed notes. It has no reference-interface, generic filesystem, shell, process, dialog, remote-origin, account, or cloud authority.",
  "windows": [
    "preview"
  ],
  "platforms": [
    "macOS"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-app-snapshot",
    "allow-open-settings-window",
    "allow-start-meeting",
    "allow-stop-meeting",
    "allow-dismiss-meeting",
    "allow-retry-startup",
    "allow-first-run-permissions",
    "allow-first-run-request-microphone",
    "allow-first-run-request-system-audio",
    "allow-library-snapshot",
    "allow-library-open-note",
    "allow-preview-library-open-evidence",
    "allow-library-open-transcript",
    "allow-operator-note",
    "allow-save-operator-note"
  ]
}
