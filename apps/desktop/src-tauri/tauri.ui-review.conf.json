{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yawn UI Review",
  "version": "0.1.0",
  "identifier": "com.ninochavez.local-meeting-notes.ui-review",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "ui-review",
        "title": "Yawn UI Review — Synthetic",
        "url": "index.html?review=synthetic",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": ["ui-review-window"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": null,
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-"
    }
  }
}
