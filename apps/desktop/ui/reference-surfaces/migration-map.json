  "mappings": [
    {
      "sourcePattern": "app-header|header-action|start-meeting-action|stop-button",
      "target": "ds-window-toolbar + ds-button",
      "kind": "shared-component",
      "reason": "The window frame owns global Record and Stop actions."
    },
    {
      "sourcePattern": "header-state|quick-control",
      "target": "ds-status-indicator",
      "kind": "shared-component",
      "reason": "One word-and-mark status presentation serves toolbar and compact capture truth."
    },
    {
      "sourcePattern": "app-workspace",
      "target": "ds-primary-window-layout",
      "kind": "shared-component",
      "reason": "The primary-window component owns the three structural panes and minimum geometry."
    },
    {
      "sourcePattern": "app-sidebar|product-nav|sidebar-primary|sidebar-footer",
      "target": "ds-product-sidebar + ds-product-sidebar-row",
      "kind": "shared-component",
      "reason": "Product navigation is one roving, selected-row component."
    },
    {
      "sourcePattern": "meeting-context|library-row|library-list|library-empty|library-search|library-filter",
      "target": "ds-meeting-list + ds-meeting-list-row + ds-empty-row",
      "kind": "shared-component",
      "reason": "Recent, filtered, loading, and empty meetings share one list grammar."
    },
    {
      "sourcePattern": "meeting-split-view|meeting-detail-content|meeting-detail-screen",
      "target": "ds-primary-window-layout + ds-meeting-record",
      "kind": "shared-component",
      "reason": "Split geometry belongs to the primary-window component; the record owns only its reading column."
    },
    {
      "sourcePattern": "meeting-workspace|meeting-heading|meeting-detail-(?:state|back)|local-badge",
      "target": "ds-meeting-record-heading + ds-locality-badge",
      "kind": "shared-component",
      "reason": "Meeting identity, time, locality, and bounded actions form one record heading."
    },
    {
      "sourcePattern": "meeting-tabs|meeting-tab-panel|retained-meeting-tabs",
      "target": "ds-text-tabs + ds-meeting-tab-panel",
      "kind": "shared-component",
      "reason": "Sibling meeting views use text tabs with one selected and one keyboard-focusable tab."
    },
    {
      "sourcePattern": "meeting-claim|meeting-no-note|meeting-retention|note-generation|claim-",
      "target": "ds-note-section + ds-source-link + ds-inline-notice",
      "kind": "shared-component",
      "reason": "Record content stays in reading order; source evidence is a quiet action, not a competing card."
    },
    {
      "sourcePattern": "workspace-empty",
      "target": "ds-empty-row",
      "kind": "shared-component",
      "reason": "Empty content is a real in-context row with a next action."
    },
    {
      "sourcePattern": "screen-actions|(?:^|\\s)\\.primary|(?:^|\\s)\\.secondary|text-button|danger",
      "target": "ds-button variants",
      "kind": "shared-component",
      "reason": "Buttons share height, shape, focus, hover, active, disabled, primary, live, and destructive behavior."
    },
    {
      "sourcePattern": "(?:^|\\s)\\.notice|form-error",
      "target": "ds-inline-notice",
      "kind": "shared-component",
      "reason": "Information, warning, and error use the same word-first notice component."
    },
    {
      "sourcePattern": "#?idle-screen|start-form|preflight-|check-row|retention-field",
      "target": "ds-consent-pattern + ds-disclosure-row + ds-field-row",
      "kind": "state-exception",
      "reason": "Consent is attempt-scoped and blocking, so this compact capture state keeps its own composition while reusing shared controls."
    },
    {
      "sourcePattern": "arming-screen|capture-state",
      "target": "ds-capture-arming-state + ds-status-indicator",
      "kind": "state-exception",
      "reason": "Arming owns waiting-for-both-channels copy; it must not look live before audio opens."
    },
    {
      "sourcePattern": "recording-screen|channel-grid|channel-mark|live-note|kicker\\.live|capture-health",
      "target": "ds-capture-live-state + ds-capture-channel + ds-operator-note",
      "kind": "state-exception",
      "reason": "Live capture has operational hierarchy and a permitted audio reading; it does not inherit meeting-record composition."
    },
    {
      "sourcePattern": "capture-progress|processing-screen|processing-card|processing-spinner",
      "target": "ds-progress-list + ds-progress-row",
      "kind": "shared-component",
      "reason": "Processing names complete, current, and pending work without an ambient spinner or wizard repeated across capture."
    },
    {
      "sourcePattern": "transcript-screen|transcript-actions|transcript-copy|transcript-turns|(?:^|\\s)\\.turn|result-handoff",
      "target": "ds-meeting-record + ds-transcript-turn + ds-button",
      "kind": "state-exception",
      "reason": "Transcript handoff exits the capture utility into the retained meeting record; it is not another capture card."
    }
  ]
}
